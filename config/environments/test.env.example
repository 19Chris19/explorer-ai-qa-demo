# Supply the actual Test hostname in the reverse proxy. None has been supplied yet.
PORT=4319
# Inside a private container network, without a host-published BFF port.
DEMO_LISTEN_HOST=0.0.0.0
DEMO_ASSET_PREFIX=/qa-app
DEMO_COOKIE_NAME=qa_test_client
DEMO_COOKIE_PATH=/qa-app/
DEMO_COOKIE_SECURE=1
DEMO_DISABLE_ADMIN=1
DEMO_RUNTIME_DIR=/var/lib/explorer-qa-test
PROVIDER_A_BASE_URL=http://provider-a:3000
PROVIDER_A_API_TOKEN=
PROVIDER_A_INTERNAL_SERVICE_TOKEN=
PROVIDER_A_KNOWLEDGE_SCOPE_REF=
DEMO_COOKIE_SECRET=
