# Tested contract: Provider A v0.4.0. Set a local tunnel port only when running on another host.
PROVIDER_A_BASE_URL=http://127.0.0.1:3117
# Add <ORDINARY_API_TOKEN> only in a private .env.local file; never commit it.
PROVIDER_A_API_TOKEN=
# Server-side credential for native Agent streaming; keep distinct from the ordinary API token.
PROVIDER_A_INTERNAL_SERVICE_TOKEN=
# SHA-256 digest of the Provider A shared knowledge-base ID, not the ID itself.
PROVIDER_A_KNOWLEDGE_SCOPE_REF=
# A separate random secret for stable website visitor cookies.
DEMO_COOKIE_SECRET=
PORT=4317
