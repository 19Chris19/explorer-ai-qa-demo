# Release baseline: Provider A v0.4.1. Runtime compatibility uses its protected contract.
PROVIDER_A_BASE_URL=http://127.0.0.1:3117
# Add <ORDINARY_API_TOKEN> only in a private .env.local file; never commit it.
PROVIDER_A_API_TOKEN=
# Server-side credential for native Agent streaming; keep distinct from the ordinary API token.
PROVIDER_A_INTERNAL_SERVICE_TOKEN=
# SHA-256 digest of the Provider A shared knowledge-base ID, not the ID itself.
PROVIDER_A_KNOWLEDGE_SCOPE_REF=
# A separate random secret for stable website visitor cookies.
DEMO_COOKIE_SECRET=
PORT=4317
# Default loopback. Set 0.0.0.0 only behind an authenticated/private proxy.
DEMO_LISTEN_HOST=127.0.0.1
# Same-origin module prefix; blank keeps the independent root entry.
DEMO_ASSET_PREFIX=
# Separate these values and secrets for demo/test/production. No Cookie Domain is used.
DEMO_COOKIE_NAME=qa_demo_client_v2
DEMO_COOKIE_PATH=/
# Set 1 behind the main site's HTTPS endpoint; keep 0 for loopback HTTP only.
DEMO_COOKIE_SECURE=0
DEMO_DISABLE_ADMIN=1
